## GCP CONFIGURATION ##
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-southeast2

### GCS CONFIGURATION ##
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_RAW_PREFIX=raw/petabencana/fire

## PUBSUB CONFIGURATION ##
PUBSUB_TOPIC_RAW=projects/your-gcp-project-id/topics/fp-aninditas-topic
PUBSUB_SUBSCRIPTION_RAW=projects/your-gcp-project-id/subscriptions/fp-aninditas-topic-sub

### BIGQUERY CONFIGURATION ##
BQ_DATASET_RAW=your_bq_dataset_raw
BQ_TABLE_BATCH_RAW=disaster_batch_raw
BQ_TABLE_STREAM_RAW=disaster_stream_raw

BQ_DATASET_STAGING=your_bq_dataset_staging
BQ_TABLE_BATCH_STAGING=disaster_batch_staging
BQ_TABLE_STREAM_STAGING=disaster_stream_staging
BQ_TABLE_BATCH_STAGING_DATA_QUALITY=disaster_batch_staging_dq
BQ_TABLE_STREAM_STAGING_DATA_QUALITY=disaster_stream_staging_dq

BQ_DATASET_CURATED=your_bq_dataset_curated
BQ_TABLE_CURATED=disaster_curated

BQ_DATASET_DIMENSION=your_bq_dataset_dimension
BQ_TABLE_DIM_REGION=dim_region
BQ_TABLE_DIM_PROVINCE=dim_province

### DIMENSION SOURCE JSON (GitHub) ##
DIM_REGION_API_URL=https://raw.githubusercontent.com/yusufsyaifudin/wilayah-indonesia/master/data/list_of_area/regencies.json
DIM_PROVINCE_API_URL=https://raw.githubusercontent.com/yusufsyaifudin/wilayah-indonesia/master/data/list_of_area/provinces.json

### POSTGRES CONFIGURATION (dimension pipeline) ##
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_postgres_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SCHEMA_DIMENSION=dimension

### SMOKE TEST CONFIGURATION ##
PETABENCANA_BASE_URL=https://data.petabencana.id/reports/archive
PETABENCANA_ARCHIVE_START=2026-01-01
PETABENCANA_ARCHIVE_END=2026-08-31

SMOKE_TEST_MAX_RECORDS=10

### BATCH NEXT-DATE STATE (historical Jan-Aug 2026) ##
BATCH_HISTORICAL_START_DATE=2026-01-01
BATCH_HISTORICAL_END_DATE=2026-08-31

### AIRFLOW EMAIL ALERT CONFIGURATION ##
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=your_user_gmail@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your_smtp_password
AIRFLOW__SMTP__SMTP_MAIL_FROM=your_user_gmail@gmail.com

# Recipient of the pipeline failure alert (your personal Gmail)
ALERT_EMAIL_TO=your_email@gmail.com
